include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCommon.cmake")
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEXTSCOPE_SOURCE}" status --porcelain -- .
    OUTPUT_VARIABLE changes COMMAND_ERROR_IS_FATAL ANY)
if(NOT changes STREQUAL "" AND NOT ALLOW_DIRTY)
    message(FATAL_ERROR "Commit TextScope release inputs first, or use -DALLOW_DIRTY=ON for local snapshots only")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEXTSCOPE_SOURCE}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEXTSCOPE_SOURCE}"
    ls-files --cached --others --exclude-standard -- .
    OUTPUT_VARIABLE files OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(files MATCHES ";")
    message(FATAL_ERROR "Source filenames containing semicolons are not supported")
endif()
string(REPLACE "\n" ";" files "${files}")
string(RANDOM LENGTH 12 id)
set(work "${OUTPUT}/source-work-${id}")
set(stage "${work}/sources")
file(MAKE_DIRECTORY "${stage}")
foreach(path IN LISTS files)
    if(path MATCHES "^(build|out|\\.git|\\.vscode)(/|$)" OR path MATCHES "(^|/)\\.DS_Store$")
        continue()
    endif()
    if(NOT EXISTS "${TEXTSCOPE_SOURCE}/${path}")
        message(FATAL_ERROR "Missing release input: ${path}")
    endif()
    get_filename_component(directory "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${stage}/${directory}")
    file(COPY "${TEXTSCOPE_SOURCE}/${path}" DESTINATION "${stage}/${directory}")
endforeach()
set(dirty false)
if(NOT changes STREQUAL "")
    set(dirty true)
endif()
file(WRITE "${stage}/SOURCE-MANIFEST.txt"
    "TextScope ${VERSION}\nrevision=${revision}\ndirty=${dirty}\n")
configure_file("${CMAKE_CURRENT_LIST_DIR}/source/CMakeLists.txt.in"
    "${work}/project/CMakeLists.txt" @ONLY)
release_run("${CMAKE_COMMAND}" -S "${work}/project" -B "${work}/config")
find_program(CPACK_EXECUTABLE cpack REQUIRED)
release_run("${CPACK_EXECUTABLE}" --config "${work}/config/CPackSourceConfig.cmake"
    -B "${work}/packages")
set(name "textscope-${VERSION}-source.tar.gz")
release_copy_immutable("${work}/packages/${name}" "${OUTPUT}/${name}")
release_checksum("${OUTPUT}/${name}")
file(REMOVE_RECURSE "${work}")
message(STATUS "Source archive: ${OUTPUT}/${name}")
