include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCommon.cmake")
release_archive()
if(NOT DEFINED LOCAL_ROOT)
    if("$ENV{HOME}" STREQUAL "")
        message(FATAL_ERROR "Set LOCAL_ROOT to an absolute directory")
    endif()
    set(LOCAL_ROOT "$ENV{HOME}/local-releases")
endif()
get_filename_component(LOCAL_ROOT "${LOCAL_ROOT}" ABSOLUTE)
set(tap "${LOCAL_ROOT}/tap")
set(artifacts "${LOCAL_ROOT}/artifacts/textscope")
set(formula "${tap}/Formula/textscope.rb")
set(destination "${artifacts}/textscope-${VERSION}-source.tar.gz")
if(EXISTS "${destination}")
    file(SHA256 "${destination}" existing)
    if(NOT existing STREQUAL SHA256)
        message(FATAL_ERROR "Existing local source archive differs: ${destination}")
    endif()
endif()
find_package(Git REQUIRED)
if(EXISTS "${tap}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${tap}" rev-parse --show-toplevel
        OUTPUT_VARIABLE git_root OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    file(REAL_PATH "${git_root}" git_root)
    file(REAL_PATH "${tap}" tap_root)
    if(NOT git_root STREQUAL tap_root)
        message(FATAL_ERROR "Tap must be its own Git repository: ${tap}")
    endif()
endif()
set(url "file://${artifacts}")
foreach(pair "%|%25" " |%20" "#|%23" "?|%3F" "\"|%22" "'|%27" "$|%24" "`|%60")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 character)
    list(GET parts 1 encoded)
    string(REPLACE "${character}" "${encoded}" url "${url}")
endforeach()
string(REPLACE ";" "%3B" url "${url}")
string(RANDOM LENGTH 12 id)
set(work "${OUTPUT}/tap-work-${id}")
release_run("${CMAKE_COMMAND}" "-DARCHIVE=${ARCHIVE}" "-DOUTPUT=${work}"
    "-DRELEASE_URL=${url}" -P "${CMAKE_CURRENT_LIST_DIR}/PrepareRecipes.cmake")
set(generated "${work}/homebrew/Formula/textscope.rb")
if(EXISTS "${formula}")
    file(SHA256 "${formula}" old)
    file(SHA256 "${generated}" new)
    if(NOT old STREQUAL new)
        if(NOT EXISTS "${tap}/.git")
            message(FATAL_ERROR "Refusing to overwrite an unversioned formula: ${formula}")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${tap}" status --porcelain -- Formula/textscope.rb
            OUTPUT_VARIABLE changes COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${tap}" ls-files --error-unmatch Formula/textscope.rb
            RESULT_VARIABLE tracked OUTPUT_QUIET ERROR_QUIET)
        if(NOT changes STREQUAL "" OR NOT tracked EQUAL 0)
            message(FATAL_ERROR "Save and commit the existing local formula first: ${formula}")
        endif()
    endif()
endif()
release_copy_immutable("${ARCHIVE}" "${destination}")
release_checksum("${destination}")
configure_file("${generated}" "${formula}" COPYONLY)
if(COMMIT_TAP)
    if(NOT EXISTS "${tap}/.git")
        release_run("${GIT_EXECUTABLE}" init "${tap}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${tap}" status --porcelain -- Formula/textscope.rb
        OUTPUT_VARIABLE changes COMMAND_ERROR_IS_FATAL ANY)
    if(NOT changes STREQUAL "")
        release_run("${GIT_EXECUTABLE}" -C "${tap}" add -- Formula/textscope.rb)
        release_run("${GIT_EXECUTABLE}" -C "${tap}" commit --only
            -m "Update TextScope ${VERSION}"
            -m "Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
            -- Formula/textscope.rb)
    endif()
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Prepared ${formula}")
message(STATUS "Not run: brew tap local/releases \"${tap}\"")
message(STATUS "Not run: brew install --build-from-source local/releases/textscope")
