include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCommon.cmake")
if(NOT DEFINED ARTIFACTS OR NOT IS_DIRECTORY "${ARTIFACTS}")
    message(FATAL_ERROR "Set ARTIFACTS to the downloaded workflow artifact directory")
endif()
if(NOT DEFINED RELEASE_TAG OR NOT RELEASE_TAG STREQUAL "textscope-v${VERSION}")
    message(FATAL_ERROR "Release tag must match TextScope version ${VERSION}")
endif()
if(EXISTS "${OUTPUT}")
    file(GLOB existing "${OUTPUT}/*")
    if(existing)
        message(FATAL_ERROR "Release asset output must be empty: ${OUTPUT}")
    endif()
endif()

set(source "${ARTIFACTS}/textscope-source-recipes")
set(ARCHIVE "${source}/textscope-${VERSION}-source.tar.gz")
release_archive()
set(assets "${ARCHIVE}")
foreach(spec
    "textscope-standalone-ubuntu-24.04|${RELEASE_TAG}-Linux-X64.tar.gz"
    "textscope-standalone-macos-latest|${RELEASE_TAG}-macOS-*.dmg"
    "textscope-standalone-ucrt64|${RELEASE_TAG}-Windows-UCRT64-X64.zip")
    string(REPLACE "|" ";" parts "${spec}")
    list(GET parts 0 artifact)
    list(GET parts 1 pattern)
    file(GLOB matches LIST_DIRECTORIES FALSE "${ARTIFACTS}/${artifact}/${pattern}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one ${artifact}/${pattern} asset; found ${count}")
    endif()
    list(APPEND assets ${matches})
endforeach()

foreach(asset IN LISTS assets)
    file(SIZE "${asset}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "Release asset is empty: ${asset}")
    endif()
    if(NOT EXISTS "${asset}.sha256")
        message(FATAL_ERROR "Release asset checksum is missing: ${asset}.sha256")
    endif()
    file(SHA256 "${asset}" expected)
    file(READ "${asset}.sha256" checksum)
    string(REPLACE "\r\n" "\n" checksum "${checksum}")
    get_filename_component(name "${asset}" NAME)
    if(NOT checksum STREQUAL "${expected}  ${name}\n")
        message(FATAL_ERROR "Release asset checksum differs: ${asset}")
    endif()
endforeach()
foreach(recipe homebrew/Formula/textscope.rb arch/PKGBUILD msys2/PKGBUILD)
    if(NOT EXISTS "${source}/${recipe}")
        message(FATAL_ERROR "Public recipe is missing: ${recipe}")
    endif()
    file(READ "${source}/${recipe}" content)
    if(NOT content MATCHES "${SHA256}" OR
       NOT content MATCHES "/releases/download/${RELEASE_TAG}/textscope-${VERSION}-source.tar.gz")
        message(FATAL_ERROR "Public recipe does not match the release source: ${recipe}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${OUTPUT}")
foreach(asset IN LISTS assets)
    get_filename_component(name "${asset}" NAME)
    release_copy_immutable("${asset}" "${OUTPUT}/${name}")
    release_checksum("${OUTPUT}/${name}")
endforeach()
string(RANDOM LENGTH 12 id)
set(work "${OUTPUT}/recipes-work-${id}")
foreach(recipe homebrew/Formula/textscope.rb arch/PKGBUILD msys2/PKGBUILD)
    configure_file("${source}/${recipe}" "${work}/${recipe}" COPYONLY)
endforeach()
set(recipes "${OUTPUT}/textscope-${VERSION}-recipes.tar.gz")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${recipes}" --format=gnutar
    homebrew arch msys2 WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
release_checksum("${recipes}")
file(REMOVE_RECURSE "${work}")
file(GLOB files LIST_DIRECTORIES FALSE "${OUTPUT}/*")
set(manifest "")
foreach(path IN LISTS files)
    file(SHA256 "${path}" hash)
    get_filename_component(name "${path}" NAME)
    string(APPEND manifest "${hash}  ${name}\n")
endforeach()
file(WRITE "${OUTPUT}/SHA256SUMS" "${manifest}")
message(STATUS "Prepared complete draft release assets in ${OUTPUT}")
