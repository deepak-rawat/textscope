cmake_minimum_required(VERSION 3.25)
include_guard(GLOBAL)

get_filename_component(TEXTSCOPE_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${TEXTSCOPE_SOURCE}/CMakeLists.txt" version_line
    REGEX "^project\\(TextScope VERSION [0-9]+\\.[0-9]+\\.[0-9]+ ")
string(REGEX REPLACE "^project\\(TextScope VERSION ([0-9.]+) .*" "\\1" VERSION "${version_line}")
if(NOT VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Cannot determine TextScope version")
endif()
if(NOT DEFINED OUTPUT)
    set(OUTPUT "${TEXTSCOPE_SOURCE}/build/releases")
endif()
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)

function(release_run)
    execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(release_checksum path)
    file(SHA256 "${path}" hash)
    get_filename_component(name "${path}" NAME)
    file(WRITE "${path}.sha256" "${hash}  ${name}\n")
endfunction()

function(release_copy_immutable source destination)
    if(EXISTS "${destination}")
        file(SHA256 "${source}" expected)
        file(SHA256 "${destination}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Refusing to overwrite a different release artifact: ${destination}")
        endif()
    else()
        configure_file("${source}" "${destination}" COPYONLY)
    endif()
endfunction()

function(release_archive)
    if(NOT DEFINED ARCHIVE)
        set(ARCHIVE "${OUTPUT}/textscope-${VERSION}-source.tar.gz")
    endif()
    get_filename_component(ARCHIVE "${ARCHIVE}" ABSOLUTE)
    if(NOT EXISTS "${ARCHIVE}" OR IS_DIRECTORY "${ARCHIVE}")
        message(FATAL_ERROR "Prepare the source archive first: ${ARCHIVE}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${ARCHIVE}"
        OUTPUT_VARIABLE contents COMMAND_ERROR_IS_FATAL ANY)
    if(NOT contents MATCHES "textscope-${VERSION}-source/CMakeLists.txt" OR
       NOT contents MATCHES "textscope-${VERSION}-source/SOURCE-MANIFEST.txt")
        message(FATAL_ERROR "Archive does not contain TextScope ${VERSION} source and provenance: ${ARCHIVE}")
    endif()
    file(SHA256 "${ARCHIVE}" SHA256)
    set(ARCHIVE "${ARCHIVE}" PARENT_SCOPE)
    set(SHA256 "${SHA256}" PARENT_SCOPE)
endfunction()
