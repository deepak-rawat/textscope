cmake_minimum_required(VERSION 3.25)
find_package(Git REQUIRED)
string(RANDOM LENGTH 12 id)
set(work "${WORK}/run-${id}")
set(fixture "${work}/project")
file(MAKE_DIRECTORY "${fixture}")
file(COPY "${SOURCE}/packaging" DESTINATION "${fixture}")
file(WRITE "${fixture}/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.25)\nproject(TextScope VERSION 0.1.0 LANGUAGES NONE)\n")
file(WRITE "${fixture}/.gitignore" "/build/\n")
file(WRITE "${fixture}/LICENSE" "Fixture license\n")
file(WRITE "${fixture}/fixture.txt" "source fixture\n")

function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}\nPreserved ${work}")
    endif()
endfunction()

function(reject expected)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected rejection '${expected}': ${ARGN}\n${output}\n${error}")
    endif()
endfunction()

run("${GIT_EXECUTABLE}" -C "${fixture}" init)
run("${GIT_EXECUTABLE}" -C "${fixture}" add .)
run("${GIT_EXECUTABLE}" -C "${fixture}" -c user.name=PackagingTest
    -c user.email=packaging-test@example.invalid commit -m Fixture)
set(output "${fixture}/build/releases")
set(source_script "${fixture}/packaging/PrepareSource.cmake")
file(WRITE "${fixture}/build/private.txt" "must not be packaged")
run("${CMAKE_COMMAND}" "-DOUTPUT=${output}" -P "${source_script}")
set(archive "${output}/textscope-0.1.0-source.tar.gz")
if(NOT EXISTS "${archive}.sha256")
    message(FATAL_ERROR "Source checksum missing")
endif()
file(SHA256 "${archive}" hash)
file(READ "${archive}.sha256" checksum)
if(NOT checksum STREQUAL "${hash}  textscope-0.1.0-source.tar.gz\n")
    message(FATAL_ERROR "Incorrect source checksum")
endif()
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}/extracted")
set(root "${work}/extracted/textscope-0.1.0-source")
if(NOT EXISTS "${root}/fixture.txt" OR NOT EXISTS "${root}/SOURCE-MANIFEST.txt" OR
   EXISTS "${root}/build" OR EXISTS "${root}/.git")
    message(FATAL_ERROR "Incorrect source archive layout")
endif()
file(APPEND "${fixture}/fixture.txt" "dirty")
reject("Commit TextScope release inputs" "${CMAKE_COMMAND}" -P "${source_script}")
run("${CMAKE_COMMAND}" "-DOUTPUT=${fixture}/build/dirty" -DALLOW_DIRTY=ON -P "${source_script}")
file(ARCHIVE_EXTRACT INPUT "${fixture}/build/dirty/textscope-0.1.0-source.tar.gz"
    DESTINATION "${work}/dirty")
file(READ "${work}/dirty/textscope-0.1.0-source/SOURCE-MANIFEST.txt" manifest)
if(NOT manifest MATCHES "dirty=true")
    message(FATAL_ERROR "Dirty source provenance missing")
endif()

set(recipes "${work}/recipes")
run("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${recipes}"
    -DRELEASE_URL=https://example.invalid/textscope-v0.1.0
    -P "${fixture}/packaging/PrepareRecipes.cmake")
reject("unsafe for package recipes" "${CMAKE_COMMAND}" "-DARCHIVE=${archive}"
    "-DOUTPUT=${recipes}" "-DRELEASE_URL=https://example.invalid/unsafe URL"
    -P "${fixture}/packaging/PrepareRecipes.cmake")
foreach(path homebrew/Formula/textscope.rb arch/PKGBUILD msys2/PKGBUILD)
    file(READ "${recipes}/${path}" content)
    if(path MATCHES "^homebrew/")
        set(homepage "homepage \"https://github.com/deepak-rawat/textscope\"")
    else()
        set(homepage "url='https://github.com/deepak-rawat/textscope'")
    endif()
    string(FIND "${content}" "${homepage}" homepage_position)
    if(content MATCHES "@[A-Z_]+@" OR NOT content MATCHES "${hash}" OR
       NOT content MATCHES "https://example.invalid/textscope-v0.1.0/textscope-0.1.0-source.tar.gz" OR
       homepage_position EQUAL -1 OR
       NOT content MATCHES "TEXTSCOPE_BUNDLE_RUNTIME=OFF" OR
       NOT content MATCHES "TEXTSCOPE_INSTALL_EXAMPLE_PLUGIN=OFF")
        message(FATAL_ERROR "Invalid recipe: ${path}")
    endif()
endforeach()

file(WRITE "${work}/invalid.tar.gz" "not a source archive")
reject(".*" "${CMAKE_COMMAND}" "-DARCHIVE=${work}/invalid.tar.gz"
    "-DOUTPUT=${recipes}" -P "${fixture}/packaging/PrepareRecipes.cmake")

set(artifacts "${work}/artifacts")
set(source_artifact "${artifacts}/textscope-source-recipes")
configure_file("${archive}" "${source_artifact}/textscope-0.1.0-source.tar.gz" COPYONLY)
configure_file("${archive}.sha256" "${source_artifact}/textscope-0.1.0-source.tar.gz.sha256" COPYONLY)
run("${CMAKE_COMMAND}" "-DARCHIVE=${archive}" "-DOUTPUT=${source_artifact}"
    -P "${fixture}/packaging/PrepareRecipes.cmake")
foreach(path homebrew/Formula/textscope.rb arch/PKGBUILD msys2/PKGBUILD)
    file(READ "${source_artifact}/${path}" content)
    string(FIND "${content}"
        "https://github.com/deepak-rawat/textscope/releases/download/textscope-v0.1.0/textscope-0.1.0-source.tar.gz"
        source_url_position)
    if(source_url_position EQUAL -1)
        message(FATAL_ERROR "Incorrect default source URL: ${path}")
    endif()
endforeach()
set(packages
    "textscope-standalone-ubuntu-24.04/textscope-v0.1.0-Linux-X64.tar.gz"
    "textscope-standalone-macos-latest/textscope-v0.1.0-macOS-ARM64.dmg"
    "textscope-standalone-ucrt64/textscope-v0.1.0-Windows-UCRT64-X64.zip"
    "textscope-arch/textscope-0.1.0-1-x86_64.pkg.tar.zst"
    "textscope-msys2/mingw-w64-ucrt-x86_64-textscope-0.1.0-1-any.pkg.tar.zst")
foreach(package IN LISTS packages)
    file(WRITE "${artifacts}/${package}" "Package fixture: ${package}\n")
    file(SHA256 "${artifacts}/${package}" hash)
    get_filename_component(name "${package}" NAME)
    if(package MATCHES "\\.zip$")
        file(WRITE "${artifacts}/${package}.sha256" "${hash}  ${name}\r\n")
    else()
        file(WRITE "${artifacts}/${package}.sha256" "${hash}  ${name}\n")
    endif()
endforeach()
file(WRITE "${artifacts}/textscope-arch/.SRCINFO" "pkgbase = textscope\n")
set(release_script "${fixture}/packaging/PrepareReleaseAssets.cmake")
set(release_output "${work}/release-assets")
set(release_args "-DARTIFACTS=${artifacts}" "-DOUTPUT=${release_output}")
reject("Release tag must match" "${CMAKE_COMMAND}" ${release_args}
    -DRELEASE_TAG=textscope-v0.2.0 -P "${release_script}")
run("${CMAKE_COMMAND}" ${release_args} -DRELEASE_TAG=textscope-v0.1.0 -P "${release_script}")
file(GLOB release_files LIST_DIRECTORIES FALSE "${release_output}/*")
list(LENGTH release_files count)
if(NOT count EQUAL 15)
    message(FATAL_ERROR "Expected seven release assets, seven sidecars and SHA256SUMS; found ${count}")
endif()
file(READ "${release_output}/SHA256SUMS" manifest)
foreach(path IN LISTS release_files)
    if(path MATCHES "/SHA256SUMS$")
        continue()
    endif()
    file(SHA256 "${path}" hash)
    get_filename_component(name "${path}" NAME)
    string(FIND "${manifest}" "${hash}  ${name}\n" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Release manifest entry is missing or incorrect: ${name}")
    endif()
endforeach()
file(ARCHIVE_EXTRACT INPUT "${release_output}/textscope-0.1.0-recipes.tar.gz"
    DESTINATION "${work}/release-recipes")
foreach(recipe homebrew/Formula/textscope.rb arch/PKGBUILD arch/.SRCINFO msys2/PKGBUILD)
    if(NOT EXISTS "${work}/release-recipes/${recipe}")
        message(FATAL_ERROR "Release recipe archive is missing ${recipe}")
    endif()
endforeach()
reject("output must be empty" "${CMAKE_COMMAND}" ${release_args}
    -DRELEASE_TAG=textscope-v0.1.0 -P "${release_script}")
set(release_args "-DARTIFACTS=${artifacts}" "-DOUTPUT=${work}/rejected-assets"
    -DRELEASE_TAG=textscope-v0.1.0)
set(zip "${artifacts}/textscope-standalone-ucrt64/textscope-v0.1.0-Windows-UCRT64-X64.zip")
file(READ "${zip}" zip_content)
file(REMOVE "${zip}")
reject("found 0" "${CMAKE_COMMAND}" ${release_args} -P "${release_script}")
file(WRITE "${zip}" "${zip_content}")
file(READ "${source_artifact}/arch/PKGBUILD" arch_recipe)
file(SHA256 "${archive}" source_hash)
string(REPLACE "${source_hash}" "incorrect-source-hash" incorrect_recipe "${arch_recipe}")
file(WRITE "${source_artifact}/arch/PKGBUILD" "${incorrect_recipe}")
reject("Public recipe does not match" "${CMAKE_COMMAND}" ${release_args} -P "${release_script}")
file(WRITE "${source_artifact}/arch/PKGBUILD" "${arch_recipe}")
file(WRITE "${artifacts}/textscope-standalone-ubuntu-24.04/textscope-v0.1.0-Linux-X64.tar.gz.sha256"
    "incorrect checksum\n")
reject("checksum differs" "${CMAKE_COMMAND}" ${release_args} -P "${release_script}")
file(REMOVE "${artifacts}/textscope-msys2/mingw-w64-ucrt-x86_64-textscope-0.1.0-1-any.pkg.tar.zst")
reject("found 0" "${CMAKE_COMMAND}" ${release_args} -P "${release_script}")
file(WRITE "${artifacts}/textscope-msys2/mingw-w64-ucrt-x86_64-textscope-0.1.0-1-any.pkg.tar.zst" "fixture\n")
file(WRITE "${artifacts}/textscope-standalone-macos-latest/textscope-v0.1.0-macOS-X64.dmg" "fixture\n")
reject("found 2" "${CMAKE_COMMAND}" ${release_args} -P "${release_script}")

if(APPLE)
    set(local "${work}/local releases #test")
    set(tap "${local}/tap")
    file(MAKE_DIRECTORY "${tap}/Formula")
    file(WRITE "${tap}/Formula/another.rb" "preserve me")
    set(tap_script "${fixture}/packaging/PrepareLocalTap.cmake")
    set(args "-DARCHIVE=${archive}" "-DOUTPUT=${output}" "-DLOCAL_ROOT=${local}")
    run("${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    file(READ "${tap}/Formula/textscope.rb" formula)
    if(NOT formula MATCHES "file://" OR NOT formula MATCHES "%20" OR NOT formula MATCHES "%23")
        message(FATAL_ERROR "Local source URL is not escaped")
    endif()
    run("${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    file(READ "${tap}/Formula/another.rb" other)
    if(NOT other STREQUAL "preserve me" OR EXISTS "${tap}/.git")
        message(FATAL_ERROR "Local tap preparation changed unrelated files or initialized Git")
    endif()
    file(APPEND "${tap}/Formula/textscope.rb" "\nlocal edit\n")
    reject("unversioned formula" "${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    run("${GIT_EXECUTABLE}" -C "${tap}" init)
    run("${GIT_EXECUTABLE}" -C "${tap}" add .)
    run("${GIT_EXECUTABLE}" -C "${tap}" -c user.name=PackagingTest
        -c user.email=packaging-test@example.invalid commit -m Fixture)
    run("${GIT_EXECUTABLE}" -C "${tap}" config user.name PackagingTest)
    run("${GIT_EXECUTABLE}" -C "${tap}" config user.email packaging-test@example.invalid)
    run("${GIT_EXECUTABLE}" -C "${tap}" config core.worktree "${fixture}")
    reject("Tap must be its own Git repository" "${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    run("${GIT_EXECUTABLE}" -C "${tap}" config --unset core.worktree)
    file(APPEND "${tap}/Formula/textscope.rb" "\nunsaved edit\n")
    reject("Save and commit" "${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    file(WRITE "${tap}/Formula/textscope.rb" "# Prior formula fixture\n")
    # Commit an older formula so the helper can safely replace it.
    run("${GIT_EXECUTABLE}" -C "${tap}" add Formula/textscope.rb)
    run("${GIT_EXECUTABLE}" -C "${tap}" commit -m "Save formula")
    file(APPEND "${tap}/Formula/another.rb" "\nunrelated edit\n")
    run("${GIT_EXECUTABLE}" -C "${tap}" add Formula/another.rb)
    run("${CMAKE_COMMAND}" ${args} -DCOMMIT_TAP=ON -P "${tap_script}")
    run("${CMAKE_COMMAND}" ${args} -DCOMMIT_TAP=ON -P "${tap_script}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${tap}" diff --cached --name-only
        OUTPUT_VARIABLE staged COMMAND_ERROR_IS_FATAL ANY)
    if(NOT staged STREQUAL "Formula/another.rb\n")
        message(FATAL_ERROR "Local tap helper committed unrelated staged changes")
    endif()
    file(WRITE "${local}/artifacts/textscope/textscope-0.1.0-source.tar.gz" "conflicting archive")
    reject("archive differs" "${CMAKE_COMMAND}" ${args} -P "${tap_script}")
    message(STATUS "Local tap safeguards passed")
else()
    message(STATUS "Skipping macOS-only local tap safeguards")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Source archives and public recipes passed")
